{
  "name": "firelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "fetch-sources": "tsx scripts/fetch-sources.ts",
    "extract-text": "tsx scripts/extract-text.ts",
    "verify-corpus": "tsx scripts/verify-corpus.ts",
    "test": "npm run verify-corpus && vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run verify-corpus && next build --webpack && npm run typecheck",
    "docs:claims": "tsx scripts/generate-claims-review.ts",
    "dev": "npm run verify-corpus && next dev",
    "lint": "eslint app components lib scripts e2e eslint.config.mjs postcss.config.mjs next.config.ts playwright.config.ts vitest.config.ts",
    "e2e": "playwright test",
    "docs:sources": "tsx scripts/generate-sources.ts",
    "check:links": "tsx scripts/check-source-links.ts"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "cheerio": "^1.0.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^4.10.38",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
